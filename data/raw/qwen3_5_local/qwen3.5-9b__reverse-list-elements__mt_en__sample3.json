  "response": "```python\ndef reverse_list_elements(elements, punctuation):\n    \"\"\"\n    Reverses the order of elements and their corresponding punctuation symbols.\n\n    Args:\n        elements (list): List of word/element strings\n        punctuation (list): List of punctuation marks corresponding to each element\n\n    Returns:\n        tuple: (new_elements, new_punctuation) - Both lists reversed with same correspondence\n\n    Raises:\n        ValueError: If lengths of elements and punctuation do not match\n\n    Example:\n        >>> reverse_list_elements([\"Hello\", \"world\"], [\"\", \"!\"])\n        ([\"world\", \"Hello\"], [\"!\", \"\"])\n    \"\"\"\n    if len(elements) != len(punctuation):\n        raise ValueError(\"elements and punctuation must have the same length\")\n    \n    # Reverse both lists using slicing\n    new_elements = elements[::-1]\n    new_punctuation = punctuation[::-1]\n    \n    return (new_elements, new_punctuation)\n\n\n# Example usage examples\nif __name__ == \"__main__\":\n    # Example from problem statement\n    elements = [\"Hello\", \"world\"]\n    punctuation = [\"\", \"!\"]\n    result = reverse_list_elements(elements, punctuation)\n    print(result)  # (['world', 'Hello'], ['!', ''])\n\n    # Additional test case\n    elements2 = [\"A\", \"B\", \"C\"]\n    punctuation2 = [\".\", \"?\", \"!\"]\n    result2 = reverse_list_elements(elements2, punctuation2)\n    print(result2)  # (['C', 'B', 'A'], ['!', '?', '.'])\n\n    # Test with single elements\n    elements3 = [\"Hi\"]\n    punctuation3 = [\",\"]\n    result3 = reverse_list_elements(elements3, punctuation3)\n    print(result3)  # (['Hi'], [','])\n```",
