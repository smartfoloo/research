 new_dist\n                predecessors[neighbor] = current_node\n                heapq.heappush(pq, (new_dist, neighbor))\n    \n    # 経路が存在しない場合\n    if end not in graph or distances[end] == float('inf'):\n        return (None, None)\n    \n    # 経路を構築\n    path = []\n    current = end\n    while current is not None:\n        path.append(current)\n        current = predecessors[current]\n    \n    path.reverse()\n    \n    return (distances[end], path)\n```\n\nWait、グラフのノードを全て登録する必要があるかも。`start` または `end` がエッジにはない可能性があるので、両方のノードを含める必要がある。また、すべてのノードを初期化してあげないと、visited のセットで問題になる。\n\n修正ポイント：\n1. 全てのノードを辞書に含める\n2. start や end を graph に含めない場合も考慮する\n\n以下のように再考します：\n\n```python\nimport heapq\n\ndef shortest_path(edges, start, end):\n    # 負のウェイトをチェック\n    for _, _, weight in edges:\n        if weight < 0:\n            raise ValueError(\"Negative weight not allowed\")\n    \n    # ノードごとの隣接リストを作成\n    graph = {}\n    all_nodes = set()\n    \n    for from_node, to_node, weight in edges:\n        if from_node not in graph:\n            graph[from_node] = []\n        if to_node not in graph:\n            graph[to_node] = []\n        \n        graph[from_node].append((to_node, weight))\n        all_nodes.add(from_node)\n        all_nodes.add(to_node)\n    \n    # start == end の場合\n    if start == end:\n        return (0, [start])\n    \n    # Dijkstra アルゴリズム\n    \n    # 初期化：各ノードまでの最短距離は無限大、前節点は None\n    distances = {node: float('inf') for node in all_nodes}\n    predecessors = {node: None for node in all_nodes}\n    \n    # start の場合の特殊処理（start がエッジに含まれていない可能性）\n    if start not in graph and start != end:\n        return (None, None)\n    \n    # 最小優先キュー\n    pq = [(0, start)]\n    distances[start] = 0\n    \n    while pq:\n        current_dist, current_node = heapq.heappop(pq)\n        \n        if current_dist > distances[current_node]:\n            continue\n        \n        if current_node not in graph:\n            continue\n            \n        # 隣接ノードを処理\n        for neighbor, weight in graph[current_node]:\n            new_dist = current_dist + weight\n            \n            if new_dist < distances[neighbor]:\n                distances[neighbor] = new_dist\n                predecessors[neighbor] = current_node\n                heapq.heappush(pq, (new_dist, neighbor))\n    \n    # 経路が存在しない場合\n    if distances[end] == float('inf'):\n        return (None, None)\n    \n    # 経路を構築\n    path = []\n    current = end\n    while current is not None:\n        path.append(current)\n        current = predecessors[current]\n    \n    path.reverse()\n    \n    return (distances[end], path)\n```\n\nこのコードは、Dijkstra アルゴリズムを使用して有向グラフの最短経路を見つけるものです。ただし、いくつかの問題点があります：\n\n1. `start` がエッジに存在しない場合、スタート地点から始まれない可能性があるが、これは正常なケースではない（graph に start ノードがない）\n2. `end` が graph に存在しない場合も考慮すべき\n\nさらに改良すると：\n\n```python\nimport heapq\n\ndef shortest_path(edges, start, end):\n    # 負のウェイトをチェック\n    for _, _, weight in edges:\n        if weight < 0:\n            raise ValueError(\"Negative weight not allowed\")\n    \n    # ノードごとの隣接リストを作成\n    graph = {node: [] for node in set(n[1] for n in edges)}\n    \n    for from_node, to_node, weight in edges:\n        if from_node not in graph:\n            graph[from_node] = []\n        graph[from_node].append((to_node, weight))\n    \n    # 経路が存在しない場合（start または end がエッジに含まれていない）\n    start_exists = any(from_node == start and to_node != start for _, from_node, _ in edges) or (not edges and start == end)\n    if not edges:\n        if start == end:\n            return (0, [start])\n        else:\n            return (None, None)\n    \n    # Dijkstra アルゴリズム\n    \n    # 初期化\n    all_nodes = set()\n    for from_node, to_node, _ in edges:\n        all_nodes.add(from_node)\n        all_nodes.add(to_node)\n    \n    distances = {node: float('inf') for node in all_nodes}\n    predecessors = {node: None for node in all_nodes}\n    distances[start] = 0\n    \n    # 優先キュー\n    pq = [(0, start)]\n    visited = set()\n    \n 